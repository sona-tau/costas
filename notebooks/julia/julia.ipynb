   "source": [
    "function tsearchbt_m(n::Int)\n",
    "    foldxt(vcat, begin\n",
    "            local_solutions = Vector{Vector{Int}}()\n",
    "            state = newstate_m(n)\n",
    "            mmark!(state, 1, first_val)\n",
    "            msearchBT!(local_solutions, state, 2)\n",
    "            local_solutions\n",
    "        end for first_val in newstate_m(n).candidates)\n",
    "end"
   ]
  },
