   "source": [
    "@inline function miscostas0(state::StateM, pos_idx::Int, candidate_val::Int)::Bool\n",
    "    @inbounds all(begin\n",
    "            prev_val::Int = state.arr[prev_pos]\n",
    "            bit::UInt64 = UInt64(1) << (candidate_val - prev_val + state.n)\n",
    "            prev_val == 0 || ((state.diffs[state.positions[pos_idx] - prev_pos + state.n] & bit) == 0)\n",
    "        end for prev_pos::Int in state.positions[1:pos_idx])\n",
    "end\n",
    "\n",
    "@inline function mmark!(state::StateM, pos_idx::Int, candidate_val::Int)::Nothing\n",
    "    @inbounds for prev_pos::Int in state.positions[1:pos_idx]\n",
    "        prev_val::Int = state.arr[prev_pos]\n",
    "\n",
    "        if prev_val == 0\n",
    "            continue\n",
    "        end\n",
    "        bit::UInt64 = UInt64(1) << (candidate_val - prev_val + state.n)\n",
    "        state.diffs[state.positions[pos_idx] - prev_pos + state.n] |= bit\n",
    "    end\n",
    "    \n",
    "    state.arr[state.positions[pos_idx]] = candidate_val\n",
    "    state.used_mask |= UInt64(1) << candidate_val\n",
    "\n",
    "    return nothing\n",
    "end\n",
    "\n",
    "@inline function munmark!(state::StateM, pos_idx::Int, candidate_val::Int)::Nothing\n",
    "    @inbounds for prev_pos::Int in state.positions[1:pos_idx]\n",
    "        prev_val::Int = state.arr[prev_pos]\n",
    "\n",
    "        if prev_val == 0\n",
    "            continue\n",
    "        end\n",
    "        bit::UInt64 = ~(UInt64(1) << (candidate_val - prev_val + state.n))\n",
    "        state.diffs[state.positions[pos_idx] - prev_pos + state.n] &= bit\n",
    "    end\n",
    "    \n",
    "    state.arr[state.positions[pos_idx]] = 0\n",
    "    state.used_mask &= ~(UInt64(1) << candidate_val)\n",
    "    \n",
    "    return nothing\n",
    "end"
   ]
  },
