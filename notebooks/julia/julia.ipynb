   "source": [
    "mutable struct StateM\n",
    "    arr::Vector{Int}\n",
    "    used_mask::UInt64\n",
    "    diffs::Vector{UInt64}\n",
    "    n::Int\n",
    "    positions::Vector{Int}\n",
    "    candidates::Vector{Int}\n",
    "end\n",
    "\n",
    "function cord_oi(n::Int)::Vector{Int}\n",
    "    order::Vector{Int} = Vector{Int}()\n",
    "    lo::Int = 1\n",
    "    hi::Int = n\n",
    "\n",
    "    while lo <= hi\n",
    "        push!(order, lo)\n",
    "        lo += 1\n",
    "\n",
    "        if lo <= hi\n",
    "            push!(order, hi)\n",
    "            hi -= 1\n",
    "        end\n",
    "    end\n",
    "\n",
    "    return order\n",
    "end\n",
    "\n",
    "\"\"\"\n",
    "\tnewstate(n::Integer)::State\n",
    "\n",
    "Return a new `State`. Not part of the public API.\n",
    "\"\"\"\n",
    "function newstate_m(n::Integer)::StateM\n",
    "    StateM(zeros(n), 0, zeros(2 * n), n, cord_oi(n), n:-1:1)\n",
    "end"
   ]
  },
