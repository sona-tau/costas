   "source": [
    "function msearchBT!(solutions::Vector{Vector{Int}}, state::StateM, pos_idx::Int)::Nothing\n",
    "    if state.arr[1] != 0 && state.arr[state.n] != 0 &&\n",
    "        (state.arr[1] >= state.arr[state.n] || state.arr[1] + state.arr[state.n] > state.n + 1) ||\n",
    "        pos_idx < (state.n >> 1) && shouldprune(state.arr, state.n)\n",
    "        return nothing\n",
    "    end\n",
    "    \n",
    "    if pos_idx > state.n\n",
    "        push!(solutions, copy(state.arr))\n",
    "        return nothing\n",
    "    end\n",
    "\n",
    "    for candidate_val in state.candidates\n",
    "        if state.used_mask & (UInt64(1) << candidate_val) != 0 ||\n",
    "            (state.positions[pos_idx] == 1 && candidate_val > (state.n >> 1)) ||\n",
    "            (state.positions[pos_idx] == state.n && candidate_val == state.n)\n",
    "            continue\n",
    "        end\n",
    "\n",
    "        if miscostas0(state, pos_idx, candidate_val)\n",
    "            mmark!(state, pos_idx, candidate_val)\n",
    "            msearchBT!(solutions, state, pos_idx + 1)\n",
    "            munmark!(state, pos_idx, candidate_val)\n",
    "        end\n",
    "    end\n",
    "\n",
    "    return nothing\n",
    "end"
   ]
  },
